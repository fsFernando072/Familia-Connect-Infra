#!/bin/bash

MANAGER_IP="${manager_ip}"
SWARM_WORKER_PARAMETER="${swarm_worker_parameter}"
NODE_HOSTNAME="${node_hostname}"

hostnamectl set-hostname "$NODE_HOSTNAME"

echo "Aguardando conexão com a internet e resolução de DNS..."
until curl -4 -s --connect-timeout 5 https://us-east-1.ec2.archive.ubuntu.com > /dev/null; do
    echo "Rede ou DNS ainda não disponíveis. Aguardando 5 segundos..."
    sleep 5
done

echo "Instalando Docker e AWS CLI..."
export DEBIAN_FRONTEND=noninteractive
apt-get update -y || true
apt-get install -y ca-certificates curl gnupg lsb-release unzip || true

# Instala AWS CLI v2 de forma simples e resiliente
if ! command -v aws >/dev/null 2>&1; then
    until curl -fsSL https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip -o /tmp/awscliv2.zip && \
          unzip -q /tmp/awscliv2.zip -d /tmp && \
          sudo /tmp/aws/install; do
        echo "Falha ao baixar a AWS CLI. Tentando novamente em 10 segundos..."
        sleep 10
    done
    rm -rf /tmp/awscliv2.zip /tmp/aws
fi

install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
chmod a+r /etc/apt/keyrings/docker.gpg

echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo "$VERSION_CODENAME") stable" | tee /etc/apt/sources.list.d/docker.list > /dev/null
apt-get update -y
apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
systemctl enable docker
systemctl start docker

set -e

echo "Aguardando token do Swarm no SSM..."
until /usr/local/bin/aws ssm get-parameter \
    --name "$SWARM_WORKER_PARAMETER" \
    --with-decryption \
    --query 'Parameter.Value' \
    --output text > /tmp/swarm-worker-token && [ -s /tmp/swarm-worker-token ] && grep -q "SWMTKN" /tmp/swarm-worker-token; do
    echo "Token ainda não disponível ou inválido. Aguardando 10 segundos..."
    sleep 10
done

WORKER_TOKEN="$(cat /tmp/swarm-worker-token | tr -d '[:space:]')"
rm -f /tmp/swarm-worker-token

until docker swarm join \
    --token "$WORKER_TOKEN" \
    "$MANAGER_IP:2377"; do
    echo "Manager ainda não está disponível. Tentando novamente..."
    sleep 10
done

echo "OCR worker $NODE_HOSTNAME entrou no Swarm."