#!/bin/bash

MANAGER_IP="${manager_ip}"
MANAGER_BOOTSTRAP="${manager_bootstrap}"
SWARM_MANAGER_PARAMETER="${swarm_manager_parameter}"
SWARM_WORKER_PARAMETER="${swarm_worker_parameter}"
STACK_FILE="/opt/familia-connect/swarm-stack.yml"

hostnamectl set-hostname "${node_hostname}"

# ---------------------------------------------------------------------
# SFTP restrito (roteiro-sftp-linux): usuário só com SFTP, sem shell,
# preso em ChrootDirectory. Recebe arquivos (ex.: stack/compose do Swarm)
# direto neste manager. Falha aqui NÃO impede o bootstrap do Swarm.
# ---------------------------------------------------------------------
configure_sftp() {
    local SFTP_USER="${sftp_username}"
    local SFTP_ROOT="${sftp_root}"
    local SFTP_DATA="$SFTP_ROOT/data"
    local SFTP_KEYS_DIR="/etc/ssh/keys/$SFTP_USER"
    local SFTP_PUBLIC_KEY="${sftp_public_key}"

    # 1. Raiz do chroot: dono root, sem escrita para o usuário
    mkdir -p "$SFTP_ROOT" || return 1
    chown root:root "$SFTP_ROOT"
    chmod 755 "$SFTP_ROOT"

    # Subpasta gravável (vista como /data dentro da sessão SFTP)
    mkdir -p "$SFTP_DATA"

    # 2. Usuário sem shell interativo, dono da subpasta de dados
    if ! id "$SFTP_USER" >/dev/null 2>&1; then
        useradd -m -s /bin/false "$SFTP_USER" || return 1
    fi
    chown -R "$SFTP_USER":"$SFTP_USER" "$SFTP_DATA"

    # 3. Chave pública (o par é gerado no cliente; aqui entra só a pública)
    mkdir -p "$SFTP_KEYS_DIR"
    printf '%s\n' "$SFTP_PUBLIC_KEY" > "$SFTP_KEYS_DIR/authorized_keys"
    chown -R "$SFTP_USER":"$SFTP_USER" "$SFTP_KEYS_DIR"
    chmod 755 /etc/ssh/keys
    chmod 700 "$SFTP_KEYS_DIR"
    chmod 600 "$SFTP_KEYS_DIR/authorized_keys"

    # 4. Bloco Match no FIM do sshd_config (idempotente)
    if ! grep -q "# BEGIN familia-connect-sftp" /etc/ssh/sshd_config; then
        cat >> /etc/ssh/sshd_config <<SSHD_EOF

# BEGIN familia-connect-sftp
Match User $SFTP_USER
    ForceCommand internal-sftp
    ChrootDirectory $SFTP_ROOT
    PermitTTY no
    X11Forwarding no
    AllowTcpForwarding no
    AuthorizedKeysFile $SFTP_KEYS_DIR/authorized_keys
    PasswordAuthentication no
    PubkeyAuthentication yes
# END familia-connect-sftp
SSHD_EOF
    fi

    # 5. Valida a sintaxe ANTES de reiniciar; se falhar, desfaz o bloco e
    #    mantém o sshd atual no ar
    if ! sshd -t; then
        sed -i '/# BEGIN familia-connect-sftp/,/# END familia-connect-sftp/d' /etc/ssh/sshd_config
        echo "sshd_config inválido; bloco SFTP removido." >&2
        return 1
    fi
    systemctl restart ssh
    echo "SFTP restrito configurado: usuário $SFTP_USER em $SFTP_ROOT (/data)."
}

configure_sftp || echo "Falha ao configurar o SFTP; seguindo com o Swarm."

install_docker() {
    echo "Aguardando conexão com a internet e resolução de DNS..."
    until curl -4 -s --connect-timeout 5 https://us-east-1.ec2.archive.ubuntu.com > /dev/null; do
        echo "Rede ou DNS ainda não disponíveis. Aguardando 5 segundos..."
        sleep 5
    done

    echo "Atualizando pacotes..."
    export DEBIAN_FRONTEND=noninteractive
    apt-get update -y || true
    apt-get install -y ca-certificates curl gnupg lsb-release unzip || true

    # Instala AWS CLI v2 de forma simples e resiliente
    if ! command -v aws >/dev/null 2>&1; then
        until curl -fsSL https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip -o /tmp/awscliv2.zip && \
            unzip -q /tmp/awscliv2.zip -d /tmp && \
            sudo /tmp/aws/install; do
            echo "Falha ao baixar a AWS CLI. Tentando novamente em 10 segundos..."
            sleep 10
        done
        rm -rf /tmp/awscliv2.zip /tmp/aws
    fi
    install -m 0755 -d /etc/apt/keyrings

    curl -fsSL https://download.docker.com/linux/ubuntu/gpg | \
        gpg --dearmor -o /etc/apt/keyrings/docker.gpg
    chmod a+r /etc/apt/keyrings/docker.gpg

    echo \
    "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] \
    https://download.docker.com/linux/ubuntu \
    $(. /etc/os-release && echo "$VERSION_CODENAME") stable" | \
    tee /etc/apt/sources.list.d/docker.list > /dev/null

    apt-get update -y
    apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin

    systemctl enable docker
    systemctl start docker
}

install_docker

set -e

if [ "$${MANAGER_BOOTSTRAP}" = "true" ]; then
    echo "Inicializando o primeiro manager do Docker Swarm..."
    if ! docker info --format '{{.Swarm.LocalNodeState}}' 2>/dev/null | grep -q '^active$'; then
        docker swarm init --advertise-addr "$${MANAGER_IP}"
    fi

    MANAGER_TOKEN="$(docker swarm join-token manager -q)"
    WORKER_TOKEN="$(docker swarm join-token worker -q)"

    echo "Publicando tokens do Swarm no SSM Parameter Store..."
    until /usr/local/bin/aws ssm put-parameter \
        --name "$${SWARM_MANAGER_PARAMETER}" \
        --type SecureString \
        --value "$MANAGER_TOKEN" \
        --overwrite; do
        echo "Aguardando permissão/acesso ao SSM..."
        sleep 10
    done

    until /usr/local/bin/aws ssm put-parameter \
        --name "$${SWARM_WORKER_PARAMETER}" \
        --type SecureString \
        --value "$WORKER_TOKEN" \
        --overwrite; do
        echo "Aguardando permissão/acesso ao SSM..."
        sleep 10
    done

    echo "Aguardando o ALB Front ser criado pela infraestrutura..."
    until /usr/local/bin/aws elbv2 describe-load-balancers --names lb-front >/tmp/familia-connect-albs.json 2>/dev/null; do
        echo "ALB Front ainda não está disponível. Aguardando 10 segundos..."
        sleep 10
    done

    FRONT_ALB_DNS="$(/usr/local/bin/aws elbv2 describe-load-balancers --names lb-front --query 'LoadBalancers[0].DNSName' --output text)"

    mkdir -p /opt/familia-connect
    cat > "$STACK_FILE" <<'STACK_EOF'
${stack_yaml}
STACK_EOF

    # Substitui somente o endpoint do ALB Front, descoberto em runtime.
    # Back e OCR são alcançados pelo nome do serviço na rede overlay do Swarm.
    sed -i "s|__FRONT_ALB_DNS__|$FRONT_ALB_DNS|g" "$STACK_FILE"
    chmod 600 "$STACK_FILE"

    echo "Aguardando os quatro workers entrarem no Swarm..."
    for NODE in fc-back-a fc-back-b fc-ocr-a fc-ocr-b; do
        until docker node inspect "$NODE" >/dev/null 2>&1; do
            echo "Aguardando $NODE..."
            sleep 10
        done
    done

    echo "Aplicando labels nos workers..."
    docker node update --label-add fc_role=back fc-back-a
    docker node update --label-add fc_role=back fc-back-b
    docker node update --label-add fc_role=ocr fc-ocr-a
    docker node update --label-add fc_role=ocr fc-ocr-b

    echo "Publicando a stack Família Connect..."
    docker stack deploy -c "$STACK_FILE" familia-connect
else
    echo "Entrando como segundo manager..."
    until /usr/local/bin/aws ssm get-parameter \
        --name "$${SWARM_MANAGER_PARAMETER}" \
        --with-decryption \
        --query 'Parameter.Value' \
        --output text > /tmp/swarm-manager-token && [ -s /tmp/swarm-manager-token ] && grep -q "SWMTKN" /tmp/swarm-manager-token; do
        echo "Aguardando token válido do manager no SSM..."
        sleep 10
    done

    MANAGER_TOKEN="$(cat /tmp/swarm-manager-token | tr -d '[:space:]')"
    until docker swarm join \
        --token "$MANAGER_TOKEN" \
        "${manager_ip}:2377"; do
        echo "Manager ainda não está disponível. Tentando novamente..."
        sleep 10
    done
    rm -f /tmp/swarm-manager-token
fi

echo "Front manager ${node_hostname} configurado no Docker Swarm."