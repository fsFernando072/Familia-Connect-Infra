#!/bin/bash
echo "Aguardando conexão com a internet e resolução de DNS..."
until curl -4 -s --connect-timeout 5 https://us-east-1.ec2.archive.ubuntu.com > /dev/null; do
    echo "Rede ou DNS ainda não disponíveis. Aguardando 5 segundos..."
    sleep 5
done
echo "Internet conectada com sucesso!"

apt update -y
apt install -y mysql-server git

# ==========================================
# CORREÇÃO: Permitir conexões externas no MySQL
# ==========================================
echo "Configurando o bind-address do MySQL para aceitar conexões remotas..."
sed -i 's/127.0.0.1/0.0.0.0/g' /etc/mysql/mysql.conf.d/mysqld.cnf

systemctl enable mysql
# O apt install já inicia o mysql com o bind-address antigo; "restart" garante
# que a config nova (0.0.0.0) seja realmente aplicada.
systemctl restart mysql

echo "Clonando repositório com o schema do banco..."
rm -rf /home/ubuntu/Familia-Connect-BD
until git clone https://github.com/fsfernando072/Familia-Connect-BD.git /home/ubuntu/Familia-Connect-BD; do
    echo "Falha ao clonar o repositório do schema. Tentando novamente em 10 segundos..."
    rm -rf /home/ubuntu/Familia-Connect-BD
    sleep 10
done

mysql < /home/ubuntu/Familia-Connect-BD/schema.sql

# Criar usuário e conceder permissões para acesso remoto das instâncias back
mysql -e "CREATE USER IF NOT EXISTS '${db_username}'@'%' IDENTIFIED BY '${db_password}';"
mysql -e "GRANT ALL PRIVILEGES ON *.* TO '${db_username}'@'%' WITH GRANT OPTION;"
mysql -e "FLUSH PRIVILEGES;"

echo "MySQL configurado com usuário ${db_username} para acesso remoto"